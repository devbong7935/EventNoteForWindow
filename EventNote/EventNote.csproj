<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>

    <!-- exe 아이콘. 창과 작업 표시줄 아이콘도 이걸 따라간다. -->
    <ApplicationIcon>Assets\EventNote.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EventNote.Support\EventNote.Support.csproj" />
    <ProjectReference Include="..\EventNote.Forms\EventNote.Forms.csproj" />
    <ProjectReference Include="..\EventNote.Main\EventNote.Main.csproj" />
    <ProjectReference Include="..\EventNote.Core\EventNote.Core.csproj" />
  </ItemGroup>

</Project>
