<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:units="clr-namespace:EventNote.Support.UI.Units;assembly=EventNote.Support"
                    xmlns:cnv="clr-namespace:EventNote.Support.Local.Converters;assembly=EventNote.Support"
                    xmlns:vm="clr-namespace:EventNote.Main.Local.ViewModels"
                    xmlns:views="clr-namespace:EventNote.Main.UI.Views"
                    mc:Ignorable="d">

    <cnv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <Style TargetType="{x:Type views:MainContent}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type views:MainContent}">
                    <Grid Margin="10" d:DataContext="{d:DesignInstance Type=vm:MainViewModel}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="280" MinWidth="220" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MinWidth="640" />
                        </Grid.ColumnDefinitions>

                        <!-- 왼쪽: 행사 목록 -->
                        <units:CardPanel Grid.Column="0" Header="행사 목록" HeaderAlignment="Left">
                            <DockPanel>
                                <UniformGrid DockPanel.Dock="Top" Columns="2" Margin="0,0,0,8">
                                    <units:AccentButton Content="행사 추가" Glyph="＋" Kind="Success" Margin="0,0,3,0"
                                                        Command="{Binding AddEventCommand}" />
                                    <units:AccentButton Content="행사 삭제" Glyph="－" Kind="Danger" Margin="3,0,0,0"
                                                        Command="{Binding DeleteEventCommand}" />
                                </UniformGrid>

                                <units:AccentButton DockPanel.Dock="Top" Content="행사 정보 편집" Kind="Neutral" Margin="0,0,0,10"
                                                    HorizontalAlignment="Stretch"
                                                    Command="{Binding EditEventCommand}" />

                                <TextBlock DockPanel.Dock="Bottom" Margin="2,8,2,0" TextWrapping="Wrap"
                                           FontSize="12" Foreground="{DynamicResource Brush.Text.Disabled}"
                                           Text="행사를 클릭하면 그 행사의 하객 명부가 오른쪽에 표시됩니다." />

                                <ListBox ItemsSource="{Binding Events}"
                                         SelectedItem="{Binding SelectedEvent, Mode=TwoWay}"
                                         ItemContainerStyle="{DynamicResource Style.ListBoxItem.Card}"
                                         ScrollViewer.VerticalScrollBarVisibility="Auto">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:EventItemViewModel}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" Text="{Binding Glyph}" FontSize="18"
                                                           VerticalAlignment="Top" Margin="0,1,8,0" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Title}" FontWeight="Bold"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{DynamicResource Brush.Text}" />
                                                    <TextBlock Text="{Binding DateText}" FontSize="12" Margin="0,2,0,0"
                                                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                                                    <TextBlock Text="{Binding SummaryText}" FontSize="12" Margin="0,1,0,0"
                                                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </units:CardPanel>

                        <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent"
                                      VerticalAlignment="Stretch" />

                        <!-- 오른쪽: 선택한 행사의 하객 명부 -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- 행사 제목 -->
                            <StackPanel Grid.Row="0" Margin="2,0,2,10">
                                <TextBlock Text="{Binding SelectedEventHeader}" FontSize="18" FontWeight="Bold"
                                           Foreground="{DynamicResource Brush.Text}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{Binding SelectedEventSubHeader}" FontSize="12" Margin="0,3,0,0"
                                           Foreground="{DynamicResource Brush.Text.Secondary}" />
                            </StackPanel>

                            <!-- 검색 + 하객 조작 -->
                            <Grid Grid.Row="1" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MaxWidth="480" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <units:SearchBar Grid.Column="0"
                                                 IsEnabled="{Binding HasSelectedEvent}"
                                                 FieldItemsSource="{Binding SearchFields}"
                                                 FieldDisplayMemberPath="Name"
                                                 SelectedField="{Binding SelectedSearchField, Mode=TwoWay}"
                                                 Text="{Binding SearchText, Mode=TwoWay}"
                                                 Placeholder="검색어 입력 후 Enter"
                                                 SearchCommand="{Binding SearchCommand}" />

                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <units:AccentButton Content="엑셀 내보내기" Glyph="⤓" Kind="Primary" Margin="0,0,8,0"
                                                        Command="{Binding ExportCurrentCommand}" />
                                    <units:AccentButton Content="하객 추가" Glyph="＋" Kind="Success" Margin="0,0,8,0"
                                                        Command="{Binding AddGuestCommand}" />
                                    <units:AccentButton Content="하객 삭제" Glyph="－" Kind="Danger"
                                                        Command="{Binding DeleteGuestsCommand}"
                                                        CommandParameter="{Binding SelectedItems, ElementName=GuestGrid}" />
                                </StackPanel>
                            </Grid>

                            <!-- 하객 리스트 -->
                            <units:CardPanel Grid.Row="2" Header="하객 리스트">
                                <Grid>
                                    <DataGrid x:Name="GuestGrid"
                                              ItemsSource="{Binding GuestsView}"
                                              SelectedItem="{Binding SelectedGuest, Mode=TwoWay}"
                                              SelectionMode="Extended"
                                              AlternationCount="2"
                                              CanUserSortColumns="True"
                                              Visibility="{Binding HasSelectedEvent, Converter={StaticResource BoolToVis}}">
                                        <DataGrid.Resources>
                                            <!-- 열은 DataContext 를 못 받는다. 이 징검다리로 건네준다. -->
                                            <units:BindingProxy x:Key="GuestGridProxy" Data="{Binding}" />
                                        </DataGrid.Resources>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="No" Binding="{Binding No}" Width="46" IsReadOnly="True">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Header="이름" Width="110"
                                                                Binding="{Binding Name, UpdateSourceTrigger=LostFocus}" />

                                            <!--
                                                UpdateSourceTrigger 를 지정하지 않으면 Tab 으로 셀을 빠져나갈 때
                                                LostFocus 가 뜨기 전에 편집 TextBox 가 치워져 값이 반영되지 않는다.
                                                (한글표기·집계가 그대로 남는 원인) 입력하는 대로 넘겨 준다.
                                            -->
                                            <DataGridTextColumn Header="금액" Width="120"
                                                                Binding="{Binding AmountText, UpdateSourceTrigger=PropertyChanged}">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                                <DataGridTextColumn.EditingElementStyle>
                                                    <Style TargetType="TextBox">
                                                        <Setter Property="HorizontalContentAlignment" Value="Right" />
                                                        <!-- 입력하는 동안 천 단위 쉼표를 넣어 준다. -->
                                                        <Setter Property="units:MoneyInput.IsEnabled" Value="True" />
                                                    </Style>
                                                </DataGridTextColumn.EditingElementStyle>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Header="한글표기" Width="140" IsReadOnly="True"
                                                                Binding="{Binding AmountInHangul}">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <DataGridTemplateColumn Header="관계" Width="110" SortMemberPath="Relation">
                                                <DataGridTemplateColumn.CellTemplate>
                                                    <DataTemplate>
                                                        <TextBlock Text="{Binding Relation}" VerticalAlignment="Center" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellTemplate>
                                                <DataGridTemplateColumn.CellEditingTemplate>
                                                    <DataTemplate>
                                                        <ComboBox IsEditable="True"
                                                                  Text="{Binding Relation, UpdateSourceTrigger=PropertyChanged}"
                                                                  ItemsSource="{Binding DataContext.RelationPresets,
                                                                                RelativeSource={RelativeSource AncestorType=Window}}" />
                                                    </DataTemplate>
                                                </DataGridTemplateColumn.CellEditingTemplate>
                                            </DataGridTemplateColumn>

                                            <DataGridTextColumn Header="소속" Width="160"
                                                                Binding="{Binding Affiliation, UpdateSourceTrigger=LostFocus}" />

                                            <!-- 칸을 비운 채 포커스를 옮기면 0 으로 채운다. MealTicketsText 가 그 처리를 한다. -->
                                            <DataGridTextColumn Header="식권" Width="64"
                                                                Binding="{Binding MealTicketsText, UpdateSourceTrigger=LostFocus}"
                                                                Visibility="{Binding Data.UsesMealTickets,
                                                                             Source={StaticResource GuestGridProxy},
                                                                             Converter={StaticResource BoolToVis}}">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>

                                            <DataGridTextColumn Header="비고" Width="*"
                                                                Binding="{Binding Note, UpdateSourceTrigger=LostFocus}" />
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <!-- 행사가 없을 때 안내 -->
                                    <TextBlock Text="왼쪽에서 행사를 선택하거나 새 행사를 추가하세요."
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource Brush.Text.Disabled}"
                                               Visibility="{Binding HasSelectedEvent, Converter={StaticResource InverseBoolToVis}}" />
                                </Grid>
                            </units:CardPanel>

                            <!-- 집계 -->
                            <Grid Grid.Row="3" Margin="0,10,0,0" Height="196">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="330" />
                                </Grid.ColumnDefinitions>

                                <units:CardPanel Grid.Column="0" Header="분류별 집계" HeaderAlignment="Left" Margin="0,0,10,0">
                                    <DataGrid ItemsSource="{Binding Summary}" IsReadOnly="True"
                                              HeadersVisibility="Column" AlternationCount="2">
                                        <DataGrid.Resources>
                                            <units:BindingProxy x:Key="SummaryGridProxy" Data="{Binding}" />
                                        </DataGrid.Resources>
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="분류" Width="110" Binding="{Binding Relation}" />
                                            <DataGridTextColumn Header="인원수" Width="80"
                                                                Binding="{Binding Count, StringFormat={}{0:N0} 명}">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="금액합계" Width="*"
                                                                Binding="{Binding Amount, StringFormat={}{0:N0} 원}">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                            <DataGridTextColumn Header="식권합계" Width="90"
                                                                Binding="{Binding Tickets, StringFormat={}{0:N0} 장}"
                                                                Visibility="{Binding Data.UsesMealTickets,
                                                                             Source={StaticResource SummaryGridProxy},
                                                                             Converter={StaticResource BoolToVis}}">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </units:CardPanel>

                                <units:CardPanel Grid.Column="1">
                                    <!--
                                        UniformGrid 는 Collapsed 된 자식을 칸 계산에서 빼 준다.
                                        식권을 안 쓰는 행사에서 아래 두 타일이 사라져도 빈칸이 남지 않는다.
                                    -->
                                    <UniformGrid Columns="1">
                                        <units:StatTile Margin="0,0,0,4" Label="전체 금액" Unit="원"
                                                        Value="{Binding TotalAmountText}"
                                                        Accent="{DynamicResource Brush.Tile.Pink}" />
                                        <units:StatTile Margin="0,0,0,4" Label="전체 인원" Unit="명"
                                                        Value="{Binding TotalGuestCountText}"
                                                        Accent="{DynamicResource Brush.Tile.Blue}" />
                                        <units:StatTile Margin="0,0,0,4" Label="전체 식권" Unit="장"
                                                        Value="{Binding TotalTicketText}"
                                                        Accent="{DynamicResource Brush.Tile.Green}"
                                                        Visibility="{Binding UsesMealTickets, Converter={StaticResource BoolToVis}}" />
                                        <units:StatTile Label="총 (식대 차감)" Unit="원"
                                                        Value="{Binding NetAmountText}"
                                                        Accent="{DynamicResource Brush.Tile.Orange}"
                                                        Visibility="{Binding UsesMealTickets, Converter={StaticResource BoolToVis}}" />
                                    </UniformGrid>
                                </units:CardPanel>
                            </Grid>
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
