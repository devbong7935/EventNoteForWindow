<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:units="clr-namespace:EventNote.Support.UI.Units;assembly=EventNote.Support"
                    xmlns:vm="clr-namespace:EventNote.Main.Local.ViewModels"
                    xmlns:views="clr-namespace:EventNote.Main.UI.Views"
                    mc:Ignorable="d">

    <!-- 다른 딕셔너리를 넘겨다보지 않도록 여기에도 따로 둔다. -->
    <BooleanToVisibilityConverter x:Key="BoolToVis" />

    <Style TargetType="{x:Type views:EventEditorWindow}">
        <!--
            BaseStyles.xaml 의 <Style TargetType="Window"> 는 암시적 스타일이라
            정확히 Window 타입에만 붙고 파생 클래스인 이 창에는 안 붙는다.
            그래서 창 공통 외형을 여기서 다시 지정한다.
        -->
        <Setter Property="Background" Value="{DynamicResource Brush.Window}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Default}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Normal}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />

        <Setter Property="Title" Value="{Binding DialogTitle}" />
        <Setter Property="Width" Value="560" />
        <Setter Property="SizeToContent" Value="Height" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="ShowInTaskbar" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type views:EventEditorWindow}">
                    <!--
                        Window 기본 템플릿에는 Background 를 칠하는 Border 가 들어 있다.
                        Template 을 갈아끼우면 그게 사라져 창 바탕이 안 칠해지므로 여기서 다시 그린다.
                    -->
                    <Border Background="{TemplateBinding Background}">
                        <AdornerDecorator>
                            <StackPanel Margin="20" d:DataContext="{d:DesignInstance Type=vm:EventEditorViewModel}">
                            <TextBlock Text="{Binding DialogTitle}" FontSize="17" FontWeight="Bold" Margin="0,0,0,4"
                                       Foreground="{DynamicResource Brush.Text}" />
                            <TextBlock Text="행사 이름이나 주최자 중 하나는 반드시 입력해야 합니다." FontSize="12" Margin="0,0,0,16"
                                       Foreground="{DynamicResource Brush.Text.Secondary}" />

                            <units:FormField Label="행사 이름">
                                <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" />
                            </units:FormField>

                            <units:FormField Label="종류">
                                <ComboBox ItemsSource="{Binding CategoryOptions}" DisplayMemberPath="Name"
                                          SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                          HorizontalAlignment="Left" Width="160" />
                            </units:FormField>

                            <units:FormField Label="주최 (혼주/상주)">
                                <TextBox Text="{Binding HostName, UpdateSourceTrigger=PropertyChanged}" />
                            </units:FormField>

                            <units:FormField Label="날짜 / 시간">
                                <StackPanel Orientation="Horizontal">
                                    <DatePicker Width="160" SelectedDate="{Binding EventDate, Mode=TwoWay}" />

                                    <ComboBox Width="62" Margin="8,0,0,0"
                                              ItemsSource="{Binding Hours}"
                                              SelectedItem="{Binding SelectedHour, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat={}{0:00}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="시" VerticalAlignment="Center" Margin="4,0,0,0"
                                               Foreground="{DynamicResource Brush.Text.Secondary}" />

                                    <ComboBox Width="62" Margin="8,0,0,0"
                                              ItemsSource="{Binding Minutes}"
                                              SelectedItem="{Binding SelectedMinute, Mode=TwoWay}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding StringFormat={}{0:00}}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBlock Text="분" VerticalAlignment="Center" Margin="4,0,0,0"
                                               Foreground="{DynamicResource Brush.Text.Secondary}" />
                                </StackPanel>
                            </units:FormField>

                            <units:FormField Label="장소">
                                <TextBox Text="{Binding Venue, UpdateSourceTrigger=PropertyChanged}" />
                            </units:FormField>

                            <units:FormField Label="식권" Hint="장례식처럼 식권을 나눠 주지 않는 행사는 꺼 두세요. 명부와 집계에서 식권 관련 항목이 모두 사라집니다.">
                                <CheckBox Content="이 행사에서 식권을 사용합니다"
                                          IsChecked="{Binding UsesMealTickets, Mode=TwoWay}"
                                          VerticalAlignment="Center" MinHeight="30"
                                          Foreground="{DynamicResource Brush.Text}" />
                            </units:FormField>

                            <units:FormField Label="식대 단가" Hint="식권 1장당 금액. 집계의 '총 (식대 차감)' 계산에 쓰입니다. 비워두면 0원."
                                             Visibility="{Binding UsesMealTickets, Converter={StaticResource BoolToVis}}">
                                <units:MoneyTextBox Text="{Binding MealPriceText, UpdateSourceTrigger=PropertyChanged}"
                                                    Suffix="원" Placeholder="0"
                                                    HorizontalAlignment="Left" Width="160" />
                            </units:FormField>

                            <units:FormField Label="메모">
                                <TextBox Text="{Binding Memo, UpdateSourceTrigger=PropertyChanged}"
                                         AcceptsReturn="True" TextWrapping="Wrap" Height="64"
                                         VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Auto" />
                            </units:FormField>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                                <units:AccentButton Content="저장" Kind="Primary" MinWidth="90" Margin="0,0,8,0"
                                                    IsDefault="True" Command="{Binding SaveCommand}" />
                                <units:AccentButton Content="취소" Kind="Neutral" MinWidth="90"
                                                    IsCancel="True" Command="{Binding CancelCommand}" />
                                </StackPanel>
                            </StackPanel>
                        </AdornerDecorator>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
