<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:units="clr-namespace:EventNote.Support.UI.Units;assembly=EventNote.Support"
                    xmlns:vm="clr-namespace:EventNote.Main.Local.ViewModels"
                    xmlns:views="clr-namespace:EventNote.Main.UI.Views"
                    mc:Ignorable="d">

    <Style TargetType="{x:Type views:MessageDialog}">
        <!--
            BaseStyles.xaml 의 <Style TargetType="Window"> 는 암시적 스타일이라
            정확히 Window 타입에만 붙고 파생 클래스인 이 창에는 안 붙는다.
            그래서 창 공통 외형을 여기서 다시 지정한다.
        -->
        <Setter Property="Background" Value="{DynamicResource Brush.Window}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="FontFamily" Value="{DynamicResource Font.Default}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Normal}" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />

        <Setter Property="Title" Value="{Binding Title}" />
        <Setter Property="Width" Value="500" />
        <Setter Property="SizeToContent" Value="Height" />
        <Setter Property="ResizeMode" Value="NoResize" />
        <Setter Property="ShowInTaskbar" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type views:MessageDialog}">
                    <!--
                        가장자리 선. 이게 없으면 흰 바탕 위에 떴을 때 창이 어디서 끝나는지 보이지 않는다.
                        WPF 창은 AllowsTransparency 없이는 그림자를 드리울 수 없어서 선 하나로 대신한다.
                    -->
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource Brush.Border.Strong}"
                            BorderThickness="1"
                            SnapsToDevicePixels="True">
                        <AdornerDecorator>
                            <!--
                                열릴 때 살짝 떠오르며 나타난다. TranslateTransform 은 배치에 영향을 주지 않아
                                SizeToContent 로 잡은 창 높이도 그대로다.
                            -->
                            <DockPanel Opacity="0" d:DataContext="{d:DesignInstance Type=vm:MessageDialogViewModel}">
                                <DockPanel.RenderTransform>
                                    <TranslateTransform Y="10" />
                                </DockPanel.RenderTransform>
                                <DockPanel.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                                                 To="1" Duration="0:0:0.14" />
                                                <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                                                                 To="0" Duration="0:0:0.22">
                                                    <DoubleAnimation.EasingFunction>
                                                        <CubicEase EasingMode="EaseOut" />
                                                    </DoubleAnimation.EasingFunction>
                                                </DoubleAnimation>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </DockPanel.Triggers>


                                <units:TitleBar DockPanel.Dock="Top"
                                                Title="{Binding Title}"
                                                ShowMark="False"
                                                ShowMinimize="False"
                                                ShowMaximize="False" />

                                <!-- 버튼 줄. 본문과 색을 달리해 눈이 답부터 찾게 한다. -->
                                <Border DockPanel.Dock="Bottom"
                                        Background="{DynamicResource Brush.Surface.Muted}"
                                        BorderBrush="{DynamicResource Brush.Border}"
                                        BorderThickness="0,1,0,0"
                                        Padding="20,14">
                                    <ItemsControl ItemsSource="{Binding Choices}" HorizontalAlignment="Right">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:DialogChoice}">
                                                <units:AccentButton Content="{Binding Text}"
                                                                    Kind="{Binding Kind}"
                                                                    MinWidth="92"
                                                                    Margin="8,0,0,0"
                                                                    Command="{Binding DataContext.ChooseCommand,
                                                                              RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Border>

                                <Grid Margin="24,22,24,22">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Border x:Name="Icon" Grid.Column="0"
                                            Width="40" Height="40" CornerRadius="12"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource Brush.Accent.Subtle}">
                                        <TextBlock x:Name="IconGlyph"
                                                   Text="?"
                                                   FontSize="22" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                                   Margin="0,-2,0,0"
                                                   Foreground="{DynamicResource Brush.Accent}" />
                                    </Border>

                                    <TextBlock Grid.Column="1"
                                               Text="{Binding Message}"
                                               Margin="16,0,0,0"
                                               VerticalAlignment="Center"
                                               TextWrapping="Wrap"
                                               LineHeight="21"
                                               Foreground="{DynamicResource Brush.Text}" />
                                </Grid>
                            </DockPanel>
                        </AdornerDecorator>
                    </Border>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding Kind}" Value="Info">
                            <Setter TargetName="IconGlyph" Property="Text" Value="i" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Kind}" Value="Error">
                            <Setter TargetName="IconGlyph" Property="Text" Value="!" />
                            <Setter TargetName="IconGlyph" Property="Foreground"
                                    Value="{DynamicResource Brush.Button.Danger.Foreground}" />
                            <Setter TargetName="Icon" Property="Background"
                                    Value="{DynamicResource Brush.Button.Danger}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
