<Project>

  <PropertyGroup>
    <!--
      앱 버전. 자동 업데이트가 "지금 돌고 있는 버전" 을 여기서 읽어 간다.
      릴리스할 때 이 값과 update/version.json 의 version 을 같은 값으로 맞춰야 한다.
      어긋나면 새로 깔고도 업데이트 알림이 계속 뜬다. 자세한 건 docs/RELEASE.md 참고.
    -->
    <Version>1.0.0.1</Version>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      VS가 F5(디버깅 시작)/테스트 실행처럼 간접적으로 트리거한 빌드에서
      분석기와 nullable 분석을 자동으로 건너뛰는 최적화를 끈다.
      ("분석기를 건너뛰어 빌드 속도를 높입니다." 메시지의 원인)
    -->
    <OptimizeImplicitlyTriggeredBuild>false</OptimizeImplicitlyTriggeredBuild>
  </PropertyGroup>

</Project>
