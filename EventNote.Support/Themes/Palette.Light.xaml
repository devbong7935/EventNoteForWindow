<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        라이트 팔레트. 뉴트럴 회색 표면 + 인디고 액센트 하나.
        Palette.Dark.xaml 과 키가 정확히 같아야 한다. 한쪽에만 있는 키는 테마를 바꾸는 순간
        예전 값이 그대로 남아 이상한 색이 된다.
    -->

    <sys:String x:Key="Theme.Name">Light</sys:String>
    <sys:Boolean x:Key="Theme.IsDark">False</sys:Boolean>

    <!-- 바탕 -->
    <SolidColorBrush x:Key="Brush.Window" Color="#F5F6F8" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Surface.Muted" Color="#F2F4F7" />
    <SolidColorBrush x:Key="Brush.Surface.Sunken" Color="#FAFBFC" />

    <!-- 선 -->
    <SolidColorBrush x:Key="Brush.Border" Color="#E4E7EC" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="#CDD3DC" />
    <SolidColorBrush x:Key="Brush.Divider" Color="#EDEFF3" />

    <!-- 글자 -->
    <SolidColorBrush x:Key="Brush.Text" Color="#1B2231" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#667085" />
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="#98A2B3" />

    <!-- 표 머리글. 예전의 짙은 회색 막대 대신 옅은 표면 + 아래 선으로 눌러 둔다. -->
    <SolidColorBrush x:Key="Brush.Header" Color="#F7F8FA" />
    <SolidColorBrush x:Key="Brush.Header.Foreground" Color="#5C6675" />
    <SolidColorBrush x:Key="Brush.Header.Hover" Color="#EDF0F4" />

    <!-- 액센트 -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#4F46E5" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#4338CA" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="#3730A3" />
    <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="#EEEFFE" />
    <SolidColorBrush x:Key="Brush.Accent.Border" Color="#C6C7F8" />
    <SolidColorBrush x:Key="Brush.Accent.Light" Color="#EEEFFE" />
    <SolidColorBrush x:Key="Brush.Focus" Color="#A5A8F5" />

    <!-- 표 행 -->
    <SolidColorBrush x:Key="Brush.Row.Alt" Color="#FAFBFC" />
    <SolidColorBrush x:Key="Brush.Row.Hover" Color="#F3F4F8" />
    <SolidColorBrush x:Key="Brush.Row.Selected" Color="#EEEFFE" />

    <!-- 버튼. Success/Danger 는 채도 높은 파스텔 대신 옅은 배경 + 진한 글자로 눌러 둔다. -->
    <SolidColorBrush x:Key="Brush.Button.Primary" Color="#4F46E5" />
    <SolidColorBrush x:Key="Brush.Button.Primary.Hover" Color="#4338CA" />
    <SolidColorBrush x:Key="Brush.Button.Primary.Foreground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Button.Primary.Border" Color="#4F46E5" />

    <SolidColorBrush x:Key="Brush.Button.Success" Color="#ECFDF3" />
    <SolidColorBrush x:Key="Brush.Button.Success.Hover" Color="#D1FADF" />
    <SolidColorBrush x:Key="Brush.Button.Success.Foreground" Color="#05683C" />
    <SolidColorBrush x:Key="Brush.Button.Success.Border" Color="#A9E5C3" />

    <SolidColorBrush x:Key="Brush.Button.Danger" Color="#FEF3F2" />
    <SolidColorBrush x:Key="Brush.Button.Danger.Hover" Color="#FEE4E2" />
    <SolidColorBrush x:Key="Brush.Button.Danger.Foreground" Color="#B42318" />
    <SolidColorBrush x:Key="Brush.Button.Danger.Border" Color="#FCC9C4" />

    <SolidColorBrush x:Key="Brush.Button.Neutral" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Button.Neutral.Hover" Color="#F5F6F8" />
    <SolidColorBrush x:Key="Brush.Button.Neutral.Foreground" Color="#344054" />
    <SolidColorBrush x:Key="Brush.Button.Neutral.Border" Color="#CDD3DC" />

    <!-- 집계 타일 강조색. 배경을 칠하지 않고 왼쪽 막대와 숫자에만 쓴다. -->
    <SolidColorBrush x:Key="Brush.Tile.Pink" Color="#D8305F" />
    <SolidColorBrush x:Key="Brush.Tile.Blue" Color="#2563EB" />
    <SolidColorBrush x:Key="Brush.Tile.Green" Color="#047857" />
    <SolidColorBrush x:Key="Brush.Tile.Orange" Color="#C2620A" />

    <!-- 스크롤바 -->
    <SolidColorBrush x:Key="Brush.Scroll.Thumb" Color="#C6CCD6" />
    <SolidColorBrush x:Key="Brush.Scroll.Thumb.Hover" Color="#A5AEBC" />

    <!-- 메뉴와 팝업 -->
    <SolidColorBrush x:Key="Brush.Menu.Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Menu.Hover" Color="#F1F2F9" />

    <!-- 오래 걸리는 일이 도는 동안 화면을 덮는 판 -->
    <SolidColorBrush x:Key="Brush.Scrim" Color="#B3F5F6F8" />

    <!-- 직접 그리는 제목줄 -->
    <SolidColorBrush x:Key="Brush.TitleBar" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Caption.Hover" Color="#ECEEF2" />
    <SolidColorBrush x:Key="Brush.Caption.Close" Color="#E5484D" />
    <SolidColorBrush x:Key="Brush.Caption.Close.Foreground" Color="#FFFFFF" />

</ResourceDictionary>
