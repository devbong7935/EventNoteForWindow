<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:EventNote.Support.UI.Units">

    <Style TargetType="{x:Type controls:SearchBar}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="MinHeight" Value="{DynamicResource Size.Control.Height}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:SearchBar}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <ComboBox x:Name="PART_Field"
                                  Grid.Column="0"
                                  Width="{TemplateBinding FieldSelectorWidth}"
                                  VerticalAlignment="Stretch"
                                  DisplayMemberPath="{Binding FieldDisplayMemberPath, RelativeSource={RelativeSource TemplatedParent}}"
                                  ItemsSource="{Binding FieldItemsSource, RelativeSource={RelativeSource TemplatedParent}}"
                                  SelectedItem="{Binding SelectedField, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" />

                        <Grid Grid.Column="1" Margin="8,0,8,0">
                            <!-- 왼쪽 여백을 비워 둔 입력칸. 그 자리에 돋보기를 얹는다. -->
                            <TextBox x:Name="PART_Editor"
                                     Padding="32,6,10,6"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding Text, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                            <Canvas x:Name="SearchIcon" Width="14" Height="14"
                                    Margin="11,0,0,0"
                                    HorizontalAlignment="Left" VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                                <Ellipse Canvas.Left="0.5" Canvas.Top="0.5" Width="10" Height="10"
                                         Stroke="{DynamicResource Brush.Text.Disabled}" StrokeThickness="1.5" />
                                <Line X1="10" Y1="10" X2="13.5" Y2="13.5"
                                      Stroke="{DynamicResource Brush.Text.Disabled}" StrokeThickness="1.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                            </Canvas>

                            <TextBlock x:Name="PlaceholderText"
                                       Text="{TemplateBinding Placeholder}"
                                       Margin="33,0,0,0"
                                       IsHitTestVisible="False"
                                       VerticalAlignment="Center"
                                       Foreground="{DynamicResource Brush.Text.Disabled}"
                                       Visibility="Collapsed" />
                        </Grid>

                        <controls:AccentButton Grid.Column="2"
                                               Kind="Neutral"
                                               MinWidth="72"
                                               Content="{TemplateBinding SearchButtonText}"
                                               Command="{Binding SearchCommand, RelativeSource={RelativeSource TemplatedParent}}"
                                               CommandParameter="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Text" Value="{x:Null}">
                            <Setter TargetName="PlaceholderText" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="SearchIcon" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
