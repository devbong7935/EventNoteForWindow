<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:EventNote.Support.UI.Units">

    <Style TargetType="{x:Type controls:FormField}">
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
        <Setter Property="Margin" Value="0,0,0,12" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:FormField}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- 라벨은 값보다 한 단계 눌러 둔다. 눈이 입력칸으로 먼저 가야 한다. -->
                        <TextBlock Grid.Row="0" Grid.Column="0"
                                   Width="{TemplateBinding LabelWidth}"
                                   Text="{TemplateBinding Label}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{DynamicResource Font.Size.Small}"
                                   TextWrapping="Wrap"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0" />

                        <ContentPresenter Grid.Row="0" Grid.Column="1"
                                          VerticalAlignment="Center"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />

                        <TextBlock x:Name="HintText"
                                   Grid.Row="1" Grid.Column="1"
                                   Text="{TemplateBinding Hint}"
                                   Margin="0,5,0,0"
                                   FontSize="{DynamicResource Font.Size.Caption}"
                                   TextWrapping="Wrap"
                                   Foreground="{DynamicResource Brush.Text.Disabled}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Hint" Value="">
                            <Setter TargetName="HintText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
