<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:EventNote.Support.UI.Units">

    <Style TargetType="{x:Type controls:AccentButton}">
        <Setter Property="Background" Value="{DynamicResource Brush.Button.Neutral}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Button.Neutral.Foreground}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border.Strong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16,7" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:AccentButton}">
                    <Grid>
                        <Border x:Name="Bd"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                SnapsToDevicePixels="True" />
                        <!-- 마우스 상태는 얇은 오버레이로 표현해서 Kind 별 색을 따로 정의하지 않는다. -->
                        <Border x:Name="Overlay"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                Background="#FFFFFF"
                                Opacity="0" />
                        <StackPanel Orientation="Horizontal"
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center">
                            <ContentPresenter x:Name="Content"
                                              RecognizesAccessKey="True"
                                              VerticalAlignment="Center"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                            <TextBlock x:Name="GlyphText"
                                       Text="{TemplateBinding Glyph}"
                                       Margin="6,0,0,0"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Glyph" Value="">
                            <Setter TargetName="GlyphText" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Overlay" Property="Background" Value="#FFFFFF" />
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.25" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Overlay" Property="Background" Value="#000000" />
                            <Setter TargetName="Overlay" Property="Opacity" Value="0.12" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource Brush.Accent}" />
                            <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Disabled}" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Kind" Value="Primary">
                <Setter Property="Background" Value="{DynamicResource Brush.Button.Primary}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Button.Primary.Foreground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Button.Primary}" />
            </Trigger>
            <Trigger Property="Kind" Value="Success">
                <Setter Property="Background" Value="{DynamicResource Brush.Button.Success}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Button.Success.Foreground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Button.Success}" />
            </Trigger>
            <Trigger Property="Kind" Value="Danger">
                <Setter Property="Background" Value="{DynamicResource Brush.Button.Danger}" />
                <Setter Property="Foreground" Value="{DynamicResource Brush.Button.Danger.Foreground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource Brush.Button.Danger}" />
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
