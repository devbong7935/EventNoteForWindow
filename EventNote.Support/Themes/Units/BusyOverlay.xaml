<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:EventNote.Support.UI.Units">

    <Style TargetType="{x:Type controls:BusyOverlay}">
        <Setter Property="Background" Value="{DynamicResource Brush.Scrim}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Opacity" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:BusyOverlay}">
                    <!-- Background 이 있어야 뒤쪽 클릭을 막는다. 투명하게 두면 그냥 통과한다. -->
                    <Border Background="{TemplateBinding Background}">
                        <Border Background="{DynamicResource Brush.Surface}"
                                BorderBrush="{DynamicResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="14"
                                Padding="28,24"
                                MinWidth="200"
                                HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="24" ShadowDepth="4" Direction="270"
                                                  Opacity="0.18" Color="#000000" />
                            </Border.Effect>

                            <StackPanel HorizontalAlignment="Center">
                                <Grid Width="40" Height="40" HorizontalAlignment="Center">
                                    <!-- 바탕 고리 -->
                                    <Ellipse Width="36" Height="36"
                                             Stroke="{DynamicResource Brush.Border}"
                                             StrokeThickness="3" />

                                    <!--
                                        도는 조각. 둘레(약 113px)의 1/4 만 그리고 나머지는 비운다.
                                        StrokeDashArray 는 선 두께가 단위라 3px 두께에서 9 는 27px 이다.
                                    -->
                                    <Ellipse x:Name="Arc" Width="36" Height="36"
                                             Stroke="{DynamicResource Brush.Accent}"
                                             StrokeThickness="3"
                                             StrokeDashArray="9 29"
                                             StrokeDashCap="Round"
                                             RenderTransformOrigin="0.5,0.5">
                                        <Ellipse.RenderTransform>
                                            <RotateTransform x:Name="ArcRotate" Angle="0" />
                                        </Ellipse.RenderTransform>
                                    </Ellipse>
                                </Grid>

                                <TextBlock x:Name="MessageText"
                                           Text="{TemplateBinding Message}"
                                           Margin="0,16,0,0"
                                           MaxWidth="280"
                                           TextAlignment="Center"
                                           TextWrapping="Wrap"
                                           FontSize="{DynamicResource Font.Size.Normal}"
                                           Foreground="{DynamicResource Brush.Text.Secondary}" />
                            </StackPanel>
                        </Border>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Message" Value="">
                            <Setter TargetName="MessageText" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <!--
                            회전은 템플릿 안의 RotateTransform 을 이름으로 집어야 해서 여기 둔다.
                            Style 쪽 Storyboard 는 템플릿 안까지 손이 닿지 않는다.
                        -->
                        <Trigger Property="IsActive" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SpinStoryboard">
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="ArcRotate"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0" To="360"
                                                         Duration="0:0:0.9"
                                                         RepeatBehavior="Forever" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <!-- 세우지 않으면 판이 사라진 뒤에도 계속 돌며 CPU 를 먹는다. -->
                                <StopStoryboard BeginStoryboardName="SpinStoryboard" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="IsActive" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <!--
                                Visibility 는 Setter 가 아니라 키프레임으로 다룬다.
                                같은 속성을 Setter 와 애니메이션이 함께 건드리면 애니메이션이 이겨서
                                되돌아가지 않는다. 그럴 바에는 한쪽으로 통일하는 편이 낫다.
                            -->
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             To="1" Duration="0:0:0.15" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                                             To="0" Duration="0:0:0.12" />
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.12" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>
