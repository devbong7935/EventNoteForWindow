<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:EventNote.Support.UI.Units">

    <!--
        예전에는 값 영역을 파스텔로 통째로 칠했다. 네 장이 나란히 서면 화면에서 가장 시끄러운
        덩어리가 돼 정작 숫자가 안 읽혔다. 이제 Accent 는 왼쪽 3px 막대와 숫자 색으로만 쓴다.
    -->

    <Style TargetType="{x:Type controls:StatTile}">
        <Setter Property="Background" Value="{DynamicResource Brush.Surface.Sunken}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text}" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Normal}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type controls:StatTile}">
                    <Border Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8"
                            SnapsToDevicePixels="True"
                            ClipToBounds="True">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="{TemplateBinding Accent}" />

                            <TextBlock Grid.Column="1"
                                       Text="{TemplateBinding Label}"
                                       Margin="12,0,8,0"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="{DynamicResource Font.Size.Small}"
                                       Foreground="{DynamicResource Brush.Text.Secondary}" />

                            <StackPanel Grid.Column="2" Orientation="Horizontal"
                                        Margin="0,0,14,0"
                                        VerticalAlignment="Center">
                                <TextBlock Text="{TemplateBinding Value}"
                                           FontWeight="Bold"
                                           FontSize="{DynamicResource Font.Size.Metric}"
                                           Foreground="{TemplateBinding Accent}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="{TemplateBinding Unit}"
                                           Margin="3,0,0,0"
                                           FontSize="{DynamicResource Font.Size.Small}"
                                           Foreground="{DynamicResource Brush.Text.Secondary}"
                                           VerticalAlignment="Bottom"
                                           Padding="0,0,0,2" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
