<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!--
        다크 팔레트. Palette.Light.xaml 과 키가 정확히 같아야 한다.
        어두운 바탕에서는 같은 색이 더 탁해 보이므로 액센트와 타일 색을 한 단계씩 밝게 잡았다.
    -->

    <sys:String x:Key="Theme.Name">Dark</sys:String>
    <sys:Boolean x:Key="Theme.IsDark">True</sys:Boolean>

    <!-- 바탕 -->
    <SolidColorBrush x:Key="Brush.Window" Color="#14161B" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#1C1F26" />
    <SolidColorBrush x:Key="Brush.Surface.Muted" Color="#23272F" />
    <SolidColorBrush x:Key="Brush.Surface.Sunken" Color="#181B21" />

    <!-- 선 -->
    <SolidColorBrush x:Key="Brush.Border" Color="#2C313A" />
    <SolidColorBrush x:Key="Brush.Border.Strong" Color="#3C434F" />
    <SolidColorBrush x:Key="Brush.Divider" Color="#262B33" />

    <!-- 글자 -->
    <SolidColorBrush x:Key="Brush.Text" Color="#E7E9EE" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#98A2B3" />
    <SolidColorBrush x:Key="Brush.Text.Disabled" Color="#667085" />

    <!-- 표 머리글 -->
    <SolidColorBrush x:Key="Brush.Header" Color="#23272F" />
    <SolidColorBrush x:Key="Brush.Header.Foreground" Color="#9AA4B4" />
    <SolidColorBrush x:Key="Brush.Header.Hover" Color="#2B303A" />

    <!-- 액센트 -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#7C7BF5" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#908FF7" />
    <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="#6663E8" />
    <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="#282B44" />
    <SolidColorBrush x:Key="Brush.Accent.Border" Color="#454785" />
    <SolidColorBrush x:Key="Brush.Accent.Light" Color="#282B44" />
    <SolidColorBrush x:Key="Brush.Focus" Color="#8E8DF6" />

    <!-- 표 행 -->
    <SolidColorBrush x:Key="Brush.Row.Alt" Color="#1F232A" />
    <SolidColorBrush x:Key="Brush.Row.Hover" Color="#262B34" />
    <SolidColorBrush x:Key="Brush.Row.Selected" Color="#2C2F4A" />

    <!-- 버튼 -->
    <SolidColorBrush x:Key="Brush.Button.Primary" Color="#5B57EC" />
    <SolidColorBrush x:Key="Brush.Button.Primary.Hover" Color="#6E6BF2" />
    <SolidColorBrush x:Key="Brush.Button.Primary.Foreground" Color="#FFFFFF" />
    <SolidColorBrush x:Key="Brush.Button.Primary.Border" Color="#5B57EC" />

    <SolidColorBrush x:Key="Brush.Button.Success" Color="#152A22" />
    <SolidColorBrush x:Key="Brush.Button.Success.Hover" Color="#1B3A2D" />
    <SolidColorBrush x:Key="Brush.Button.Success.Foreground" Color="#6EE7B7" />
    <SolidColorBrush x:Key="Brush.Button.Success.Border" Color="#2C5A46" />

    <SolidColorBrush x:Key="Brush.Button.Danger" Color="#2E1A1A" />
    <SolidColorBrush x:Key="Brush.Button.Danger.Hover" Color="#3E2222" />
    <SolidColorBrush x:Key="Brush.Button.Danger.Foreground" Color="#FDA29B" />
    <SolidColorBrush x:Key="Brush.Button.Danger.Border" Color="#5E2F2C" />

    <SolidColorBrush x:Key="Brush.Button.Neutral" Color="#252A32" />
    <SolidColorBrush x:Key="Brush.Button.Neutral.Hover" Color="#2E343E" />
    <SolidColorBrush x:Key="Brush.Button.Neutral.Foreground" Color="#D5D9E0" />
    <SolidColorBrush x:Key="Brush.Button.Neutral.Border" Color="#3C434F" />

    <!-- 집계 타일 강조색 -->
    <SolidColorBrush x:Key="Brush.Tile.Pink" Color="#FB7185" />
    <SolidColorBrush x:Key="Brush.Tile.Blue" Color="#60A5FA" />
    <SolidColorBrush x:Key="Brush.Tile.Green" Color="#34D399" />
    <SolidColorBrush x:Key="Brush.Tile.Orange" Color="#FBBF24" />

    <!-- 스크롤바 -->
    <SolidColorBrush x:Key="Brush.Scroll.Thumb" Color="#3C434F" />
    <SolidColorBrush x:Key="Brush.Scroll.Thumb.Hover" Color="#525B69" />

    <!-- 메뉴와 팝업 -->
    <SolidColorBrush x:Key="Brush.Menu.Surface" Color="#22262E" />
    <SolidColorBrush x:Key="Brush.Menu.Hover" Color="#2E333D" />

    <!-- 오래 걸리는 일이 도는 동안 화면을 덮는 판 -->
    <SolidColorBrush x:Key="Brush.Scrim" Color="#B314161B" />

    <!-- 직접 그리는 제목줄 -->
    <SolidColorBrush x:Key="Brush.TitleBar" Color="#1C1F26" />
    <SolidColorBrush x:Key="Brush.Caption.Hover" Color="#2E333D" />
    <SolidColorBrush x:Key="Brush.Caption.Close" Color="#E5484D" />
    <SolidColorBrush x:Key="Brush.Caption.Close.Foreground" Color="#FFFFFF" />

</ResourceDictionary>
