<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        앱에서 병합할 진입점.
        App.cs 의 LoadResources 에서 아래 한 줄만 병합하면 색과 기본 컨트롤 외형이 모두 적용된다.
        pack://application:,,,/EventNote.Support;component/Themes/AppTheme.xaml

        팔레트는 여기서 라이트로 시작하고, 실행 중에는 ThemeManager 가 이 자리의
        Palette.*.xaml 만 바꿔 끼운다. 그래서 팔레트는 반드시 다른 딕셔너리보다 먼저 와야 한다.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/EventNote.Support;component/Themes/Tokens.xaml" />
        <ResourceDictionary Source="/EventNote.Support;component/Themes/Palette.Light.xaml" />
        <ResourceDictionary Source="/EventNote.Support;component/Themes/BaseStyles.xaml" />
    </ResourceDictionary.MergedDictionaries>

</ResourceDictionary>
